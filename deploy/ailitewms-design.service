[Unit]
Description=AILiteWMS static design preview
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/ailitewms-design
ExecStart=/usr/bin/python3 -m http.server 8888 --bind 0.0.0.0 --directory /opt/ailitewms-design
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/ailitewms-design

[Install]
WantedBy=multi-user.target
